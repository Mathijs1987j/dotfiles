// GENERATED from config.org ("User: mathijs / niri"). Do not edit; edit config.org.
// niri configuration (KDL format). Home Manager links
// ~/.config/niri/config.kdl to this file in your repository, and niri
// reloads it on every save: changes apply at once, no rebuild needed.
// A typo shows a red error banner and niri keeps the last good config.
// Check it with:  niri validate
// Full reference: https://yalter.github.io/niri/  (Configuration pages)
// "Mod" is the Super (Windows) key; inside a nested window it becomes Alt.

input {
    keyboard {
        xkb {
            layout "us"
            variant "altgr-intl"
        }
        numlock
    }
    touchpad {
        tap
        natural-scroll
        dwt                      // disable while typing
    }
    focus-follows-mouse max-scroll-amount="0%"
}

// Displays. List yours with `niri msg outputs`, then for example:
// output "eDP-1" { scale 1.25; }

layout {
    gaps 12
    center-focused-column "never"
    preset-column-widths {      // Mod+R cycles through these
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }
    focus-ring {
        width 3
        active-color "#89b4fa"
        inactive-color "#45475a"
    }
    border { off; }
}

// Named workspaces (chapter 4.3). They always exist, in this order, at the
// top of each monitor: "main" is workspace 1, "web" 2, "chat" 3. Unnamed
// workspaces appear below them as needed. Mod+1, Mod+2, ... still work.
workspace "main"
workspace "web"
workspace "chat"

// Programs started with the session. The bar, notifications, idle/lock,
// applets and the Emacs daemon are systemd user services from Home Manager,
// so they are not listed here.
spawn-at-startup "swaybg" "-c" "#313244"

prefer-no-csd                   // ask apps not to draw their own title bars
screenshot-path "~/Pictures/Screenshots/%Y-%m-%d %H-%M-%S.png"

hotkey-overlay {
    skip-at-startup             // Mod+Shift+/ shows the key list any time
}

// Where windows open. Find an app's id with `niri msg windows` while it runs.
window-rule {
    match app-id=r#"^(librewolf|firefox)$"#
    open-on-workspace "web"
}
window-rule {
    match app-id=r#"(?i)signal"#
    match app-id=r#"^whatsapp$"#             // WhatsApp Web (whatsapp-web, apps.nix)
    match app-id=r#"^thunderbird$"#
    open-on-workspace "chat"
}

// Picture-in-picture videos float on top.
window-rule {
    match app-id=r#"^(librewolf|firefox)$"# title="^Picture-in-Picture$"
    open-floating true
}
window-rule {
    match app-id="com.saivert.pwvucontrol"
    open-floating true
}
window-rule {
    geometry-corner-radius 6
    clip-to-geometry true
}
// foot shows in different colour focus ring, to distinguish from Alacritty.
window-rule {
    match app-id="^foot$"
    focus-ring { active-color "#a6e3a1"; }   // foot: green ring
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Launching
    Mod+T hotkey-overlay-title="Terminal: Alacritty" { spawn "alacritty"; }
    Mod+Shift+T hotkey-overlay-title="Terminal: foot" { spawn "foot"; }
    Mod+D hotkey-overlay-title="Launcher: fuzzel" { spawn "fuzzel"; }
    Mod+E hotkey-overlay-title="Emacs (client frame)" { spawn "emacsclient" "-c"; }
    // Mod+B: go to the browser, starting it if needed (it opens on "web").
    Mod+B hotkey-overlay-title="Browser (focus or start)" { spawn "run-or-raise" "librewolf" "librewolf"; }
    Mod+Shift+B hotkey-overlay-title="New browser window" { spawn "librewolf" "--new-window"; }
    Mod+M hotkey-overlay-title="Mail (focus or start)" { spawn "run-or-raise" "thunderbird" "thunderbird"; }
    // Mod+Shift+W: WhatsApp Web in its own window (it opens on "chat").
    Mod+Shift+W hotkey-overlay-title="WhatsApp (focus or start)" { spawn "run-or-raise" "whatsapp" "whatsapp-web"; }
    Mod+S hotkey-overlay-title="Signal (focus or start)" { spawn "run-or-raise" "signal" "signal-desktop"; }
    Mod+Shift+S hotkey-overlay-title="Spotify (focus or start)" { spawn "run-or-raise" "spotify" "spotify"; }
    Mod+X hotkey-overlay-title="Power menu" { spawn "power-menu"; }
    Mod+N hotkey-overlay-title="Dismiss notifications" { spawn "makoctl" "dismiss" "--all"; }
    Mod+Shift+N hotkey-overlay-title="Show last notification again" { spawn "makoctl" "restore"; }
    Mod+Shift+C hotkey-overlay-title="Clipboard history" {
        spawn-sh "cliphist list | fuzzel --dmenu | cliphist decode | wl-copy";
    }
    Super+Alt+L hotkey-overlay-title="Lock the screen" { spawn "swaylock"; }
    // Mod+Shift+I: show which program the focused window belongs to.
    Mod+Shift+I hotkey-overlay-title="Which program is this?" { spawn-sh r#"notify-send "$(niri msg --json focused-window | jq -r .app_id)" "$(niri msg --json focused-window | jq -r .title)""#; }

    // Volume, media and brightness keys (also work on the lock screen)
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86AudioPlay        allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "playerctl next"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }

    // Windows
    Mod+Q repeat=false { close-window; }
    Mod+O repeat=false { toggle-overview; }

    // Moving focus: arrows or h/j/k/l. Columns are left/right,
    // windows inside a column are up/down.
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-or-workspace-up; }
    Mod+Down  { focus-window-or-workspace-down; }
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+K     { focus-window-or-workspace-up; }
    Mod+J     { focus-window-or-workspace-down; }
    Mod+Home  { focus-column-first; }
    Mod+End   { focus-column-last; }

    // Moving windows: add Ctrl
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Up    { move-window-up-or-to-workspace-up; }
    Mod+Ctrl+Down  { move-window-down-or-to-workspace-down; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+L     { move-column-right; }
    Mod+Ctrl+K     { move-window-up-or-to-workspace-up; }
    Mod+Ctrl+J     { move-window-down-or-to-workspace-down; }

    // Stacking windows into one column and out again
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+W { toggle-column-tabbed-display; }

    // Monitors: add Shift (focus) or Shift+Ctrl (move)
    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }

    // Workspaces are stacked vertically per monitor
    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+U              { focus-workspace-down; }
    Mod+I              { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }
    Mod+Shift+WheelScrollDown { focus-column-right; }
    Mod+Shift+WheelScrollUp   { focus-column-left; }

    // Sizes
    Mod+R       { switch-preset-column-width; }
    Mod+F       { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C       { center-column; }
    Mod+Minus   { set-column-width "-10%"; }
    Mod+Equal   { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // Floating windows
    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    // Screenshots (saved to ~/Pictures/Screenshots and copied)
    Print      { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print  { screenshot-window; }

    // Projector: mirror the current screen into a window; move that window
    // to the projector and make it fullscreen (Mod+Shift+F).
    Mod+P repeat=false hotkey-overlay-title="Mirror this screen (wl-mirror)" {
        spawn-sh "wl-mirror $(niri msg --json focused-output | jq -r .name)";
    }

    // Session
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+P { power-off-monitors; }
    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }
}
