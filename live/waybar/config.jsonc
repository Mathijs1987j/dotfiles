// GENERATED from config.org ("Desktop / Bar"). Do not edit; edit config.org.
{
  "layer": "top",
  "position": "top",
  "height": 28,
  "reload_style_on_change": true,

  // Workspaces only, no window titles or task list.
  "modules-left": ["niri/workspaces"],
  "modules-center": ["clock"],
  "modules-right": [
    "custom/dotfiles",
    "custom/failed",
    "cpu",
    "memory",
    "disk",
    "temperature",
    "pulseaudio",
    "backlight",
    "battery",
    "power-profiles-daemon",
    "tray"
  ],

  // Named workspaces show their name ("web", "chat"), the others their number.
  "niri/workspaces": { "format": "{value}" },

  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },

  // "rebuild" when the Nix files changed since the last rebuild (click to
  // rebuild), and a note when a new NixOS release is out.
  "custom/dotfiles": {
    "exec": "$HOME/.local/bin/dotfiles-status",
    "return-type": "json",
    "interval": 60,
    "signal": 8, // pkill -RTMIN+8 waybar: check now (rebuild and saving do)
    "on-click": "alacritty -e sh -c 'rebuild; printf \"\\nDone. Press Enter to close. \"; read _'"
  },

  // Failed services, system and session: hidden while there are none.
  // Hover for their names; click for systemd's own report. (Waybar's own
  // systemd-failed-units module could stay at "0 failed" after login: it
  // checks systemd's state when it starts, while the session is still
  // starting, and is not told when that ends.)
  "custom/failed": {
    "exec": "$HOME/dotfiles/live/bin/failed-units",
    "return-type": "json",
    "interval": 60,
    "on-click": "alacritty -e sh -c 'systemctl --failed; systemctl --user --failed; printf \"\\nPress Enter to close. \"; read _'"
  },

  // System information.
  "cpu": { "format": "cpu {usage}%", "interval": 5 },
  "memory": {
    "format": "mem {percentage}%",
    "tooltip-format": "{used:0.1f} of {total:0.1f} GiB in use, swap {swapUsed:0.1f} GiB",
    "interval": 10
  },
  "disk": {
    "path": "/",
    "format": "disk {free} free",
    "tooltip-format": "{used} of {total} used on {path} ({percentage_used}%)",
    "interval": 60
  },
  "temperature": {
    "format": "{temperatureC}°C",
    "critical-threshold": 85,
    "interval": 10
  },

  "pulseaudio": {
    "format": "vol {volume}%",
    "format-muted": "vol muted",
    "on-click": "pwvucontrol"
  },
  "backlight": { "format": "light {percent}%" },
  // The battery as an icon that empties in five steps (from the Nerd Font);
  // a bolt while charging, a plug when full on the adapter. Hover for the
  // exact percentage and the time to empty or full.
  "battery": {
    "format": "{icon}",
    "format-charging": "{icon} \uf0e7",
    "format-plugged": "{icon} \uf1e6",
    "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
    "tooltip-format": "{capacity}%, {timeTo}",
    "states": { "warning": 25, "critical": 10 }
  },
  "tray": { "spacing": 8 }
}
