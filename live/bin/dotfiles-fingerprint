#!/usr/bin/env bash
# GENERATED from config.org ("Foundations / Rebuild status"). Do not edit; edit config.org.
# dotfiles-fingerprint: one checksum over everything Nix reads (flake.nix and
# nix/, as git knows them, and the lines of config.el that name the Emacs
# packages Nix installs). Equal fingerprints mean equal configurations.
set -euo pipefail
cd "$HOME/dotfiles"
{
  git ls-files -z -- flake.nix nix | sort -z | xargs -0 cat --
  grep -E '\(use-package |:ensure' live/emacs/config.el || true
} | sha256sum | cut -d' ' -f1
